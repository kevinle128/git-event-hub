# Secrets for git-event-hub. The YAML configuration names each variable;
# copy this file to .env and fill in the values. Never commit .env.

# Postgres URL (database.urlEnv). docker-compose sets it for the bundled db.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/git-event-hub?sslmode=disable

# Bearer token for /api/* and /metrics (api.tokenEnv). Empty = those endpoints refuse every request.
HUB_API_TOKEN=

# Webhook secret of the GitHub App (source "github", secretEnv).
GITHUB_WEBHOOK_SECRET=
# Secret token of the GitLab group webhook (source "gitlab", secretEnv); several tokens may be separated by commas.
GITLAB_WEBHOOK_TOKEN=

# One secret per sink, as named in config/example.yaml.
OMB_KEVIN_SECRET=
HERMES_LAN_SECRET=
