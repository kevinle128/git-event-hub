{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://git-event-hub/schema/pr-event.v1.json",
  "title": "PrEvent v1",
  "description": "One fact about one pull request (GitHub) or merge request (GitLab). A consumer must ignore fields it does not know: version 1 may gain optional fields.",
  "type": "object",
  "required": ["v", "id", "provider", "repo", "number", "kind", "headSha", "baseRef", "branch", "author", "occurredAt", "data"],
  "properties": {
    "v": { "const": 1, "description": "Contract version." },
    "id": { "type": "string", "minLength": 1, "description": "\"<provider>:<forge delivery id>:<index>\". A repeated webhook delivery gives the same id." },
    "provider": { "enum": ["github", "gitlab"] },
    "repo": { "type": "string", "minLength": 1, "description": "\"owner/name\" on GitHub, the full project path on GitLab." },
    "number": { "type": "integer", "minimum": 1, "description": "Pull request number or merge request iid." },
    "kind": { "enum": ["opened", "pushed", "ci.finished", "review.finished", "merged", "closed", "conflict", "comment"] },
    "headSha": { "type": ["string", "null"], "description": "Head commit of the pull request. Null when unknown." },
    "baseRef": { "type": ["string", "null"], "description": "Target branch name. Null when unknown." },
    "branch": { "type": ["string", "null"], "description": "Source branch name. Null when unknown." },
    "author": { "type": ["string", "null"], "description": "Login of the person who opened the pull request. Null when unknown." },
    "occurredAt": { "type": "string", "format": "date-time", "description": "Time that the forge gives for the event." },
    "data": { "type": "object", "description": "Depends on kind; see $defs." }
  },
  "oneOf": [
    { "properties": { "kind": { "const": "opened" }, "data": { "$ref": "#/$defs/opened" } } },
    { "properties": { "kind": { "const": "pushed" }, "data": { "$ref": "#/$defs/pushed" } } },
    { "properties": { "kind": { "const": "ci.finished" }, "data": { "$ref": "#/$defs/ciFinished" } } },
    { "properties": { "kind": { "const": "review.finished" }, "data": { "$ref": "#/$defs/reviewFinished" } } },
    { "properties": { "kind": { "const": "merged" }, "data": { "$ref": "#/$defs/merged" } } },
    { "properties": { "kind": { "const": "closed" }, "data": { "$ref": "#/$defs/closed" } } },
    { "properties": { "kind": { "const": "conflict" }, "data": { "$ref": "#/$defs/conflict" } } },
    { "properties": { "kind": { "const": "comment" }, "data": { "$ref": "#/$defs/comment" } } }
  ],
  "$defs": {
    "opened": {
      "type": "object",
      "required": ["title", "url", "draft", "reopened"],
      "properties": {
        "title": { "type": "string" },
        "url": { "type": "string" },
        "draft": { "type": "boolean" },
        "reopened": { "type": "boolean", "description": "True when the pull request was opened again." }
      }
    },
    "pushed": {
      "type": "object",
      "required": ["before", "after", "url"],
      "properties": {
        "before": { "type": ["string", "null"], "description": "Head before the push, when the forge says." },
        "after": { "type": "string", "description": "Head after the push." },
        "url": { "type": "string" }
      }
    },
    "failedJob": {
      "type": "object",
      "required": ["id", "name", "url"],
      "properties": {
        "id": { "type": "string", "description": "Forge id of the job, check run or status, as a string." },
        "name": { "type": "string" },
        "url": { "type": "string" },
        "stage": { "type": "string" },
        "conclusion": { "type": "string", "description": "Raw forge conclusion, for example failure or timed_out." }
      }
    },
    "ciFinished": {
      "type": "object",
      "required": ["source", "scope", "name", "status", "url", "failedJobs"],
      "properties": {
        "source": { "type": "string", "description": "github-actions, gitlab-ci, the slug of a check suite app, or status:<context>." },
        "scope": { "enum": ["workflow", "suite", "job", "status", "pipeline"] },
        "name": { "type": "string" },
        "status": { "enum": ["passed", "failed", "cancelled", "skipped"] },
        "url": { "type": "string" },
        "runId": { "type": "string" },
        "failedJobs": { "type": "array", "items": { "$ref": "#/$defs/failedJob" }, "description": "Never null. A GitHub workflow or suite event lists no jobs." }
      }
    },
    "reviewItem": {
      "type": "object",
      "required": ["round", "scope", "real", "fixed", "unresolved"],
      "properties": {
        "round": { "type": "integer", "minimum": 1 },
        "scope": { "enum": ["full", "commit"] },
        "real": { "type": "integer", "minimum": 0 },
        "fixed": { "type": "integer", "minimum": 0 },
        "unresolved": { "type": "integer", "minimum": 1 }
      }
    },
    "reviewFinished": {
      "type": "object",
      "required": ["source", "status", "reviewedSha", "rounds", "maxRounds", "items", "commenter", "commentId", "commentUrl"],
      "properties": {
        "source": { "const": "ocr" },
        "status": { "enum": ["success", "needs-person", "failed"] },
        "reviewedSha": { "type": "string", "description": "Last commit that the review chain looked at. Compare it with the pull request head." },
        "rounds": { "type": "integer", "minimum": 0 },
        "maxRounds": { "type": "integer", "minimum": 0 },
        "items": { "type": "array", "items": { "$ref": "#/$defs/reviewItem" }, "description": "Rounds that left real findings unfixed." },
        "commenter": { "type": "string" },
        "commentId": { "type": "string" },
        "commentUrl": { "type": "string" }
      }
    },
    "merged": {
      "type": "object",
      "required": ["mergeCommitSha", "mergedBy", "url"],
      "properties": {
        "mergeCommitSha": { "type": ["string", "null"] },
        "mergedBy": { "type": ["string", "null"] },
        "url": { "type": "string" }
      }
    },
    "closed": {
      "type": "object",
      "required": ["closedBy", "url"],
      "properties": {
        "closedBy": { "type": ["string", "null"] },
        "url": { "type": "string" }
      }
    },
    "conflict": {
      "type": "object",
      "required": ["state", "url"],
      "properties": {
        "state": { "type": "string", "description": "Raw forge value, for example dirty or conflict." },
        "url": { "type": "string" }
      }
    },
    "comment": {
      "type": "object",
      "required": ["commentId", "url", "commenter", "edited", "body", "bodyTruncated"],
      "properties": {
        "commentId": { "type": "string" },
        "url": { "type": "string" },
        "commenter": { "type": "string" },
        "edited": { "type": "boolean" },
        "body": { "type": "string", "description": "Cut to 32768 bytes." },
        "bodyTruncated": { "type": "boolean" },
        "markerError": { "type": "string", "description": "Set when the body has a review block that cannot be read." }
      }
    }
  }
}
