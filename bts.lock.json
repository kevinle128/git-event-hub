    "apps/server/.env.example": "# Application settings\nHOST=0.0.0.0\nPORT=8080\n\n# Allowed web origin for CORS (unset or empty = allow any origin)\nCORS_ORIGIN=http://localhost:5173\n\n# Database settings (if using GORM, sqlc, Ent, Bun, or sqlx)\nDATABASE_URL=app.db\n\n# gRPC settings (if using gRPC)\nGRPC_PORT=50051\n\n# Logging level\nLOG_LEVEL=debug\n\n# OpenAPI HTTP address\nOPENAPI_ADDR=:8081\n",
    "apps/web/package.json": "{\n  \"name\": \"web\",\n  \"version\": \"0.0.0\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"scripts\": {\n    \"check-types\": \"tsc --noEmit\",\n    \"dev\": \"vite dev\",\n    \"build\": \"vite build\",\n    \"serve\": \"vite preview\",\n    \"start\": \"vite\",\n    \"test\": \"vitest run --passWithNoTests\"\n  },\n  \"dependencies\": {\n    \"@base-ui/react\": \"^1.8.0\",\n    \"class-variance-authority\": \"^0.7.1\",\n    \"clsx\": \"^2.1.1\",\n    \"next-themes\": \"^0.4.6\",\n    \"react\": \"19.2.8\",\n    \"react-dom\": \"19.2.8\",\n    \"react-router\": \"^8.4.0\",\n    \"sonner\": \"^2.0.8\",\n    \"tailwind-merge\": \"^3.7.0\",\n    \"@hookform/resolvers\": \"^5.9.1\",\n    \"shadcn\": \"^4.21.1\",\n    \"@tanstack/react-form\": \"^1.33.0\",\n    \"@tailwindcss/vite\": \"^4.3.3\",\n    \"tw-animate-css\": \"^1.4.0\",\n    \"zod\": \"catalog:\",\n    \"dotenv\": \"catalog:\",\n    \"@git-event-hub/env\": \"workspace:*\",\n    \"radix-ui\": \"^1.6.7\",\n    \"lucide-react\": \"^1.21.0\",\n    \"@fontsource-variable/inter\": \"^5.3.0\"\n  },\n  \"devDependencies\": {\n    \"@types/node\": \"^26.6.4\",\n    \"@types/react\": \"~19.2.18\",\n    \"@types/react-dom\": \"~19.2.7\",\n    \"@vitejs/plugin-react\": \"^6.1.1\",\n    \"postcss\": \"^8.5.15\",\n    \"tailwindcss\": \"^4.3.3\",\n    \"typescript\": \"^5\",\n    \"vite\": \"^8.3.2\",\n    \"@git-event-hub/config\": \"workspace:*\",\n    \"vitest\": \"4.1.8\",\n    \"@vitest/ui\": \"4.1.8\",\n    \"@vitest/coverage-v8\": \"4.1.8\",\n    \"jsdom\": \"^29.1.1\",\n    \"@testing-library/dom\": \"^10.4.2\",\n    \"@testing-library/user-event\": \"^14.6.7\",\n    \"@testing-library/jest-dom\": \"^6.9.1\",\n    \"@testing-library/react\": \"^16.3.3\"\n  }\n}\n",
    "package.json": "{\n  \"name\": \"git-event-hub\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"workspaces\": {\n    \"packages\": [\n      \"apps/*\",\n      \"packages/*\"\n    ],\n    \"catalog\": {\n      \"dotenv\": \"^17.4.2\",\n      \"zod\": \"^4.6.5\",\n      \"@types/bun\": \"^1.4.2\"\n    }\n  },\n  \"scripts\": {\n    \"dev\": \"concurrently --kill-others \\\"bun run --filter web dev\\\" \\\"bash scripts/native/task-1.sh\\\"\",\n    \"build\": \"bun run --if-present --filter '*' build\",\n    \"check-types\": \"bun run --if-present --filter '*' check-types\",\n    \"dev:web\": \"bun run --filter web dev\",\n    \"dev:server\": \"bash scripts/native/task-1.sh\",\n    \"setup:server\": \"bash scripts/native/task-2.sh\",\n    \"check:server\": \"bash scripts/native/task-3.sh\",\n    \"test:server\": \"bash scripts/native/task-3.sh\",\n    \"setup:part:backend:go:echo\": \"bash scripts/native/task-2.sh\",\n    \"dev:part:backend:go:echo\": \"bash scripts/native/task-1.sh\",\n    \"check:part:backend:go:echo\": \"bash scripts/native/task-3.sh\",\n    \"test:part:backend:go:echo\": \"bash scripts/native/task-3.sh\",\n    \"db:local\": \"bun run --filter @git-event-hub/db db:local\",\n    \"test\": \"bun run --filter web test\"\n  },\n  \"devDependencies\": {\n    \"concurrently\": \"^9.2.1\",\n    \"typescript\": \"^6.0.3\",\n    \"@git-event-hub/config\": \"workspace:*\",\n    \"@types/bun\": \"catalog:\"\n  },\n  \"packageManager\": \"bun@1.3.5\",\n  \"dependencies\": {\n    \"dotenv\": \"catalog:\",\n    \"zod\": \"catalog:\",\n    \"@git-event-hub/env\": \"workspace:*\"\n  }\n}\n",
    "packages/config/package.json": "{\n  \"name\": \"@git-event-hub/config\",\n  \"version\": \"0.0.0\",\n  \"private\": true\n}\n",
